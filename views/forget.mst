{{>header}}

<h1>Esqueci senha</h1>

<form method="POST">
    <input type="hidden" name="_csrf" value="{{csrfToken}}"/>
    <label>
        Email:
        <input type="email" name="email" />
    </label>
    <br/>
    <label>
        <input type="submit" value="Redefinir Senha" />
    </label>
</form>
