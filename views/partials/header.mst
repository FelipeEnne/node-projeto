<html>
    <head>

        <title>{{pageTitle}}  {{h.defaultPageTitle}}</title>
        <link rel="stylesheet" href="/assets/css/style.css" />
    </head>
    <body>
    <header>
        <h1>Cabeçalho</h1>
        {{#user}}
            Olá, <a href="/profile">{{user.name}}</a>! 
        {{/user}}
        <hr/>
        <ul>
            {{#h.menu}}
                <li>
                    {{#post}}
                    <form method="POST" action="{{slug}}" style="display:inline">
                        <input type="hidden" name="_csrf" value="{{csrfToken}}"/>
                        <button type="submit" style="background:none;border:none;padding:0;color:inherit;text-decoration:underline;cursor:pointer;font:inherit">{{name}}</button>
                    </form>
                    {{/post}}
                    {{^post}}
                    <a href="{{slug}}">{{name}}</a>
                    {{/post}}
                </li>
            {{/h.menu}}
        </ul>
    </header>
        <hr/>
        {{#flashes}}
            <div>
                {{#success}}
                    <div class="warning">{{.}}</div>
                {{/success}}
                {{#error}}
                    <div class="warning">{{.}}</div>
                {{/error}}
                {{#info}}
                    <div class="warning">{{.}}</div>
                {{/info}}
            </div>
        {{/flashes}}
